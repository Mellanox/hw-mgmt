{
  "defaults": {
    "timeout_sec": 120,
    "gzip": true,
    "gzip_level": 5,
    "min_free_mb": 64
  },
  "vendors": {
    "Virtium": {
      "models": {
        "VTPM24CEXI080-BM110006": {
          "tool": "vtFA_RTK_5766_v2",
          "args": ["{device}"],
          "device_form": "controller",
          "timeout_sec": 90
        }
      }
    },
    "Phison": {
      "models": {
        "ESLS080GTUE-A329IJ1-TYJN": {
          "tool": "PCIETOOL08-6130_RD_Dump2_(Nvidia)_Linux_64bit_v2",
          "args": ["-device_index", "{device}"],
          "device_form": "namespace",
          "timeout_sec": 120
        }
      }
    },
    "Silicon Motion": {
      "models": {
        "MD681GEEBC82": {
          "tool": "NVMe_Tool_SM2268XT2_Ferri_64_Z0717A",
          "args": ["{device}", "one_button"],
          "device_form": "namespace",
          "timeout_sec": 120,
          "stage_from": "/usr/share/hw-management-ssd/smi",
          "stage_cfg": "one_button_NV.cfg",
          "keep_dirs": ["one_button"]
        }
      }
    }
  }
}
