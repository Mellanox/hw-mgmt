{
  "defaults": {
    "timeout_sec": 120,
    "min_free_mb": 64
  },
  "vendors": {
    "Virtium": {
      "models": {
        "VTPM24CEXI080-BM110006": {
          "tool": "virtium_nvme_dump_v2",
          "args": ["{device}"],
          "device_form": "controller",
          "timeout_sec": 90
        }
      }
    },
    "Phison": {
      "models": {
        "ESLS080GTUE-A329IJ1-TYJN": {
          "tool": "phison_nvme_dump_v2",
          "args": ["-device_index", "{device}"],
          "device_form": "namespace",
          "timeout_sec": 120
        }
      }
    },
    "Silicon Motion": {
      "models": {
        "MD681GEEBC82": {
          "tool": "smi_nvme_dump_v1",
          "args": ["{device}", "one_button"],
          "device_form": "namespace",
          "timeout_sec": 120,
          "stage_from": "/usr/share/hw-management-ssd/smi",
          "stage_cfg": "one_button_NV.cfg",
          "keep_dirs": ["one_button"]
        }
      }
    }
  }
}
