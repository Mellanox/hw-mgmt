[Unit]
Description=Chassis HW management service of Nvidia systems
Documentation=man:hw-management.service(8)
Wants=hw-management-sysfs-monitor.service
Wants=hw-management-fast-sysfs-monitor.service
# The updaters declare PartOf=, which propagates stop only. Without Wants= they
# stay dead after a stop/start cycle of this service.
Wants=hw-management-peripheral-updater.service
Wants=hw-management-thermal-updater.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStartPre=-/bin/sh -c "/usr/bin/hw-management-ready.sh"
ExecStartPre=-/usr/sbin/logrotate --state /var/lib/logrotate/status /etc/logrotate.d/hw-mgmt-trace
ExecStart=/bin/sh -c "/usr/bin/hw-management.sh start"
ExecStop=/bin/sh -c "/usr/bin/hw-management.sh stop"
ExecStopPost=/bin/sleep 3

[Install]
WantedBy=multi-user.target
