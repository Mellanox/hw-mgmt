[Unit]
Description=HW Management Fast Completion Monitor
After=hw-management.service
Requires=hw-management.service
PartOf=hw-management.service

StartLimitIntervalSec=1200
StartLimitBurst=10

[Service]
Type=oneshot
# Type=oneshot does not treat SIGTERM as success. Stop/reboot kills the
# still-running monitor loop (status=15/TERM) and logs Failed with result 'signal'.
SuccessExitStatus=0 SIGINT SIGTERM
ExecStart=/bin/sh -c "/usr/bin/hw-management-fast-sysfs-monitor.sh start"
ExecStop=/bin/sh -c "/usr/bin/hw-management-fast-sysfs-monitor.sh stop"

Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
