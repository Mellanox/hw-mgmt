[Unit]
Description=ASIC FAN PWM/tacho control via mlxreg (PCIe) for Nvidia systems
After=hw-management.service
Requires=hw-management.service
PartOf=hw-management.service
Documentation=man:hw-management.service(8)

# Started/stopped from hw-management-thermal-events.sh on sxcore
# chipup/chipdown for SN2700 (MSN2700*). Do not enable globally.

StartLimitIntervalSec=1200
StartLimitBurst=15

[Service]
ExecStart=/bin/sh -c "/usr/bin/hw_management_pwm_control.py"
ExecStop=/bin/kill $MAINPID
TimeoutStopSec=10

Restart=on-failure
RestartSec=60s
