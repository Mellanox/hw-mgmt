From holla@backport Mon Sep 17 00:00:00 2001
From: Sudeep Holla <sudeep.holla@arm.com>
Date: Mon, 17 Feb 2025 15:38:56 +0000
Subject: [PATCH] firmware: arm_ffa: Stash ffa_device instead of notify_type

Backport of upstream a3d73fe8ae5d onto Linux 6.12.94.
6.12 still passes a notifier_cb_info pointer into update_notifier_cb(),
so the device pointer is stored on that object instead of adopting the
later callback-pointer prototype.

Upstream-commit: a3d73fe8ae5d

diff --git a/drivers/firmware/arm_ffa/driver.c b/drivers/firmware/arm_ffa/driver.c
index 74a8d49..d81ecfe 100644
--- a/drivers/firmware/arm_ffa/driver.c
+++ b/drivers/firmware/arm_ffa/driver.c
@@ -1109,9 +1109,9 @@ static int ffa_memory_lend(struct ffa_mem_ops_args *args)
 
 struct notifier_cb_info {
 	struct hlist_node hnode;
+	struct ffa_device *dev;
 	ffa_notifier_cb cb;
 	void *cb_data;
-	enum notify_type type;
 };
 
 static int
@@ -1191,16 +1191,17 @@ notifier_hash_node_get(u16 notify_id, enum notify_type type)
 	struct notifier_cb_info *node;
 
 	hash_for_each_possible(drv_info->notifier_hash, node, hnode, notify_id)
-		if (type == node->type)
+		if (type == ffa_notify_type_get(node->dev->vm_id))
 			return node;
 
 	return NULL;
 }
 
-static int update_notifier_cb(int notify_id, enum notify_type type,
+static int update_notifier_cb(struct ffa_device *dev, int notify_id,
 			      struct notifier_cb_info *cb)
 {
 	struct notifier_cb_info *cb_info = NULL;
+	enum notify_type type = ffa_notify_type_get(dev->vm_id);
 	bool cb_found, is_registration = !!cb;
 
 	cb_info = notifier_hash_node_get(notify_id, type);
@@ -1210,6 +1211,7 @@ static int update_notifier_cb(int notify_id, enum notify_type type,
 		return -EINVAL;
 
 	if (is_registration) {
+		cb->dev = dev;
 		hash_add(drv_info->notifier_hash, &cb->hnode, notify_id);
 	} else {
 		hash_del(&cb_info->hnode);
@@ -1222,7 +1224,6 @@ static int update_notifier_cb(int notify_id, enum notify_type type,
 static int ffa_notify_relinquish(struct ffa_device *dev, int notify_id)
 {
 	int rc;
-	enum notify_type type = ffa_notify_type_get(dev->vm_id);
 
 	if (ffa_notifications_disabled())
 		return -EOPNOTSUPP;
@@ -1232,7 +1233,7 @@ static int ffa_notify_relinquish(struct ffa_device *dev, int notify_id)
 
 	write_lock(&drv_info->notify_lock);
 
-	rc = update_notifier_cb(notify_id, type, NULL);
+	rc = update_notifier_cb(dev, notify_id, NULL);
 	if (rc) {
 		pr_err("Could not unregister notification callback\n");
 		write_unlock(&drv_info->notify_lock);
@@ -1252,7 +1253,6 @@ static int ffa_notify_request(struct ffa_device *dev, bool is_per_vcpu,
 	int rc;
 	u32 flags = 0;
 	struct notifier_cb_info *cb_info = NULL;
-	enum notify_type type = ffa_notify_type_get(dev->vm_id);
 
 	if (ffa_notifications_disabled())
 		return -EOPNOTSUPP;
@@ -1264,7 +1264,6 @@ static int ffa_notify_request(struct ffa_device *dev, bool is_per_vcpu,
 	if (!cb_info)
 		return -ENOMEM;
 
-	cb_info->type = type;
 	cb_info->cb_data = cb_data;
 	cb_info->cb = cb;
 
@@ -1277,7 +1276,7 @@ static int ffa_notify_request(struct ffa_device *dev, bool is_per_vcpu,
 	if (rc)
 		goto out_unlock_free;
 
-	rc = update_notifier_cb(notify_id, type, cb_info);
+	rc = update_notifier_cb(dev, notify_id, cb_info);
 	if (rc) {
 		pr_err("Failed to register callback for %d - %d\n",
 		       notify_id, rc);
