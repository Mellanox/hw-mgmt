+		mask = readl(pmc->wake + WAKE_AOWAKE_TIER2_ROUTING(pmc, i));
+		pmc->wake_status[i] = readl(pmc->wake + WAKE_AOWAKE_STATUS_R(pmc, i)) & mask;
 	}
 
