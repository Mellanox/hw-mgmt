From xu@backport Mon Sep 17 00:00:00 2001
From: Javen Xu <javen_xu@realsil.com.cn>
Date: Fri, 9 Jan 2026 15:04:14 +0800
Subject: [PATCH] r8169: add DASH support for RTL8127AP

Backport of upstream 3259d2cf9427 onto Linux 6.12.94.
17e9f841dd22 added this and was reverted by 596c696301b1; 3259d2cf9427
is the version that landed. RTL8127AP is mac version 80 with PCI revision
0x04. 6.12 uses version 66 for RTL8126A, so that upstream case is not
carried. The RTL_DASH_25_BP start/stop helpers come from b11bff90f2ad.

Upstream-commit: 3259d2cf9427

diff --git a/drivers/net/ethernet/realtek/r8169_main.c b/drivers/net/ethernet/realtek/r8169_main.c
index 9784d10..1bf2c6a 100644
--- a/drivers/net/ethernet/realtek/r8169_main.c
+++ b/drivers/net/ethernet/realtek/r8169_main.c
@@ -634,6 +634,7 @@ enum rtl_dash_type {
 	RTL_DASH_NONE,
 	RTL_DASH_DP,
 	RTL_DASH_EP,
+	RTL_DASH_25_BP,
 };
 
 struct rtl8169_private {
@@ -1390,10 +1391,19 @@ static void rtl8168ep_driver_start(struct rtl8169_private *tp)
 	rtl_dash_loop_wait_high(tp, &rtl_ep_ocp_read_cond, 10000, 30);
 }
 
+static void rtl8125bp_driver_start(struct rtl8169_private *tp)
+{
+	r8168ep_ocp_write(tp, 0x01, 0x14, OOB_CMD_DRIVER_START);
+	r8168ep_ocp_write(tp, 0x01, 0x18, 0x00);
+	r8168ep_ocp_write(tp, 0x01, 0x10, 0x01);
+}
+
 static void rtl8168_driver_start(struct rtl8169_private *tp)
 {
 	if (tp->dash_type == RTL_DASH_DP)
 		rtl8168dp_driver_start(tp);
+	else if (tp->dash_type == RTL_DASH_25_BP)
+		rtl8125bp_driver_start(tp);
 	else
 		rtl8168ep_driver_start(tp);
 }
@@ -1412,10 +1422,19 @@ static void rtl8168ep_driver_stop(struct rtl8169_private *tp)
 	rtl_dash_loop_wait_low(tp, &rtl_ep_ocp_read_cond, 10000, 10);
 }
 
+static void rtl8125bp_driver_stop(struct rtl8169_private *tp)
+{
+	r8168ep_ocp_write(tp, 0x01, 0x14, OOB_CMD_DRIVER_STOP);
+	r8168ep_ocp_write(tp, 0x01, 0x18, 0x00);
+	r8168ep_ocp_write(tp, 0x01, 0x10, 0x01);
+}
+
 static void rtl8168_driver_stop(struct rtl8169_private *tp)
 {
 	if (tp->dash_type == RTL_DASH_DP)
 		rtl8168dp_driver_stop(tp);
+	else if (tp->dash_type == RTL_DASH_25_BP)
+		rtl8125bp_driver_stop(tp);
 	else
 		rtl8168ep_driver_stop(tp);
 }
@@ -1438,6 +1457,7 @@ static bool rtl_dash_is_enabled(struct rtl8169_private *tp)
 	case RTL_DASH_DP:
 		return r8168dp_check_dash(tp);
 	case RTL_DASH_EP:
+	case RTL_DASH_25_BP:
 		return r8168ep_check_dash(tp);
 	default:
 		return false;
@@ -1452,6 +1472,12 @@ static enum rtl_dash_type rtl_get_dash_type(struct rtl8169_private *tp)
 		return RTL_DASH_DP;
 	case RTL_GIGA_MAC_VER_51 ... RTL_GIGA_MAC_VER_53:
 		return RTL_DASH_EP;
+	case RTL_GIGA_MAC_VER_80:
+		/* RTL8127AP is revision 0x04. 6.12 uses VER_66 for RTL8126A,
+		 * so the upstream VER_66 DASH case does not apply here.
+		 */
+		return (tp->pci_dev->revision == 0x04) ? RTL_DASH_25_BP
+						       : RTL_DASH_NONE;
 	default:
 		return RTL_DASH_NONE;
 	}
