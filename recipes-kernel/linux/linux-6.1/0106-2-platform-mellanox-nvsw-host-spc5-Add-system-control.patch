From 3fd3ed156ec9554a816ebf5bf15159ecffc2823c Mon Sep 17 00:00:00 2001
From: Vadim Pasternak <vadimp@nvidia.com>
Date: Sun, 15 Jun 2025 13:13:26 +0300
Subject: [PATCH] platform/mellanox: nvsw-host-spc5: Add system control and
 monitoring driver for Nvidia SPC5 switches

The driver allows system control and monitoring of Nvidia SPC5 based
switches through CPLD/FPGA devices from the host CPU.

This control includes:
- Handling of hotplug events.
- Various resets handling through sysfs attributes.
- Reset cause reports through sysfs attributes.
- Mux attributes for hw components selection.
- General purpose registers attributes.
- LED control.
- FAN control.

Signed-off-by: Vadim Pasternak <vadimp@nvidia.com>
---
 drivers/platform/mellanox/Kconfig          |  10 +
 drivers/platform/mellanox/Makefile         |   1 +
 drivers/platform/mellanox/nvsw-host-spc5.c | 952 +++++++++++++++++++++
 3 files changed, 963 insertions(+)
 create mode 100644 drivers/platform/mellanox/nvsw-host-spc5.c

diff --git a/drivers/platform/mellanox/Kconfig b/drivers/platform/mellanox/Kconfig
index 985cd2f..8b8e925 100644
--- a/drivers/platform/mellanox/Kconfig
+++ b/drivers/platform/mellanox/Kconfig
@@ -123,6 +123,16 @@ config NVSW_HOST_NVL6
 	  This driver can also be built as a module. If so the module
 	  will be called nvsw-host-nvl6.
 
+config NVSW_HOST_SPC5
+	tristate "Nvidia SPC5 host CPLD/FPGA Hardware Control and Monitoring"
+	depends on HWMON && I2C
+	select REGMAP_I2C
+	help
+	  Say Y here to include support for the FPGA/CPLD logic by host CPU
+	  equipped on Nvidia SPC5 ethernet switches.
+	  This driver can also be built as a module. If so the module
+	  will be called nvsw-host-spc5.
+
 config NVSW_HOST_SPC6
 	tristate "Nvidia SPC6 host CPLD/FPGA Hardware Control and Monitoring"
 	depends on HWMON && I2C
diff --git a/drivers/platform/mellanox/Makefile b/drivers/platform/mellanox/Makefile
index 17cc4fd..5f8e9a5 100644
--- a/drivers/platform/mellanox/Makefile
+++ b/drivers/platform/mellanox/Makefile
