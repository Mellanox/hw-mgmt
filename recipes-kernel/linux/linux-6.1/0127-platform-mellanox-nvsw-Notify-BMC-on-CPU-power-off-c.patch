From d47c71672080fbb7245f31b761586e38c111560a Mon Sep 17 00:00:00 2001
From: Felix Radensky <fradensky@nvidia.com>
Date: Wed, 11 Nov 2026 15:51:07 +0200
Subject: platform: mellanox: nvsw: Notify BMC on CPU power off completion

On NVL6 and SPC6 systems the BMC owns the CPU power rails and keeps them
up until the CPU reports that it has completed its power off sequence.
Without that report the BMC removes the power only after a 20 second
delay, so a software initiated power off takes longer than it needs to.

Report completion from a power off prepare handler. Power off handlers
may not sleep while reaching the CPLD goes over I2C, and by the time the
prepare stage runs devices have already been shut down, so the CPU is as
ready to lose power as it is going to be. Halt is deliberately not
covered, because the only hook it reaches runs before device shutdown.

The handler is registered only when the host driver asks for it through
the new cpu_pwr_off_notify field, set for N6100_LD and N6300_LD (NVL6)
and for SN6600, SN6600_LD, SN6800_LD and SN6810_LD (SPC6).

Signed-off-by: Felix Radensky <fradensky@nvidia.com>
---
 drivers/platform/mellanox/nvsw-core.c      | 44 ++++++++++++++++++++++
 drivers/platform/mellanox/nvsw-host-nvl6.c |  1 +
 drivers/platform/mellanox/nvsw-host-spc6.c |  1 +
 drivers/platform/mellanox/nvsw.h           |  7 ++++
 4 files changed, 53 insertions(+)

diff --git a/drivers/platform/mellanox/nvsw-core.c b/drivers/platform/mellanox/nvsw-core.c
index d3e4b04961eb..4913df1a246f 100644
--- a/drivers/platform/mellanox/nvsw-core.c
+++ b/drivers/platform/mellanox/nvsw-core.c
@@ -13,6 +13,7 @@
 #include <linux/of_irq.h>
 #include <linux/platform_data/mlxreg.h>
 #include <linux/platform_device.h>
+#include <linux/reboot.h>
 #include <linux/regmap.h>
 #include "nvsw.h"
 
@@ -740,8 +741,31 @@ static int nvsw_core_regmap_init(struct nvsw_core *nvsw_core)
 	return 0;
 }
 
+/*
+ * The BMC owns the CPU power rails and keeps them up until the CPU reports
+ * that it has completed its power off sequence. Once the report is made the
+ * BMC removes the power, so there is nothing left for the CPU to wait for.
+ *
+ * This runs from the power off prepare stage rather than from a power off
+ * handler, because power off handlers are not allowed to sleep while reaching
+ * the CPLD over I2C is.
+ */
+static int nvsw_core_poweroff_prepare(struct sys_off_data *data)
+{
+	struct nvsw_core *nvsw_core = data->cb_data;
+	int err;
+
+	err = regmap_set_bits(nvsw_core->regmap, NVSW_REG_GP0_OFFSET,
+			      NVSW_GP0_CPU_PWR_OFF_RDY_MASK);
+	if (err)
+		dev_err(nvsw_core->dev, "Failed to report CPU power off ready\n");
+
+	return NOTIFY_DONE;
+}
+
 int nvsw_core_init(struct nvsw_core *nvsw_core)
 {
+	struct sys_off_handler *sys_off;
 	int err;
 
 	err = nvsw_core_regmap_init(nvsw_core);
@@ -756,7 +780,25 @@ int nvsw_core_init(struct nvsw_core *nvsw_core)
 	if (err)
 		goto nvsw_core_platform_init_fail;
 
+	if (nvsw_core->cpu_pwr_off_notify) {
+		/*
+		 * Not device managed: on I2C systems the regmap dies with
+		 * the client, which the host driver removes before platform
+		 * devres runs.
+		 */
+		sys_off = register_sys_off_handler(SYS_OFF_MODE_POWER_OFF_PREPARE,
+						   SYS_OFF_PRIO_DEFAULT,
+						   nvsw_core_poweroff_prepare, nvsw_core);
+		if (IS_ERR(sys_off)) {
+			err = PTR_ERR(sys_off);
+			goto nvsw_core_pwr_off_notify_fail;
+		}
+		nvsw_core->sys_off = sys_off;
+	}
+
 	return 0;
+nvsw_core_pwr_off_notify_fail:
+	nvsw_core_platform_exit(nvsw_core);
 nvsw_core_platform_init_fail:
 	nvsw_core_mux_topology_exit(nvsw_core);
 nvsw_core_mux_topology_init_fail:
@@ -766,6 +808,8 @@ EXPORT_SYMBOL(nvsw_core_init);
 
 void nvsw_core_exit(struct nvsw_core *nvsw_core)
 {
+	if (nvsw_core->cpu_pwr_off_notify)
+		unregister_sys_off_handler(nvsw_core->sys_off);
 	nvsw_core_platform_exit(nvsw_core);
 	nvsw_core_mux_topology_exit(nvsw_core);
 	if (nvsw_core->set_reg_default)
diff --git a/drivers/platform/mellanox/nvsw-host-nvl6.c b/drivers/platform/mellanox/nvsw-host-nvl6.c
index b76ef0904296..80f35771d9a0 100644
--- a/drivers/platform/mellanox/nvsw-host-nvl6.c
+++ b/drivers/platform/mellanox/nvsw-host-nvl6.c
@@ -693,6 +693,7 @@ static int nvsw_host_probe(struct platform_device *pdev)
 		nvsw_core->wd_data[i] = nvsw_wd_data[i];
 	nvsw_core->regio_data = nvsw_regs_io_data;
 	nvsw_core->led_data = nvsw_led_data;
+	nvsw_core->cpu_pwr_off_notify = true;
 	nvsw_core->port_map = nvsw_host_nvl6_port_map;
 	nvsw_core->mux_init = nvsw_host_nvl6_mux_topology_init;
 	nvsw_core->mux_exit = nvsw_host_nvl6_mux_topology_exit;
diff --git a/drivers/platform/mellanox/nvsw-host-spc6.c b/drivers/platform/mellanox/nvsw-host-spc6.c
index 7458f62bf8f1..fbdbb2ac68ef 100644
--- a/drivers/platform/mellanox/nvsw-host-spc6.c
+++ b/drivers/platform/mellanox/nvsw-host-spc6.c
@@ -1443,6 +1443,7 @@ static int nvsw_host_probe(struct platform_device *pdev)
 	nvsw_core->regio_data = nvsw_regs_io_data;
 	nvsw_core->led_data = nvsw_led_data;
 	nvsw_core->fan_data = nvsw_fan_data;
+	nvsw_core->cpu_pwr_off_notify = true;
 	nvsw_core->mux_init = nvsw_host_spc6_mux_topology_init;
 	nvsw_core->mux_exit = nvsw_host_spc6_mux_topology_exit;
 	nvsw_core->set_reg_default = nvsw_host_spc6_set_reg_default;
diff --git a/drivers/platform/mellanox/nvsw.h b/drivers/platform/mellanox/nvsw.h
index c2b67079692f..7053f5da5d71 100644
--- a/drivers/platform/mellanox/nvsw.h
+++ b/drivers/platform/mellanox/nvsw.h
@@ -8,6 +8,8 @@
 #ifndef __NVSW_H__
 #define __NVSW_H__
 
+#include <linux/reboot.h>
+
 /* I2C bus IO offsets */
 #define NVSW_REG_CPLD1_VER_OFFSET	0x2500
 #define NVSW_REG_CPLD2_VER_OFFSET	0x2501
@@ -232,6 +234,7 @@
 #define NVSW_UID_PUSH_BUTTON_MASK	BIT(7)
 #define NVSW_RTC_MASK			BIT(0)
 #define NVSW_HOT_SWAP_ALERT_MASK	BIT(1)
+#define NVSW_GP0_CPU_PWR_OFF_RDY_MASK	BIT(6)
 #define NVSW_LED_LO_NIBBLE_MASK		GENMASK(7, 4)
 #define NVSW_LED_HI_NIBBLE_MASK		GENMASK(3, 0)
 #define NVSW_UART_SEL_MASK		GENMASK(7, 6)
@@ -296,6 +299,8 @@ enum nvsw_core_regmap_type {
  * @mux_exit: mux de-initialization callback;
  * @mux: mux devices;
  * @mux_num: number of mux device;
+ * @cpu_pwr_off_notify: notify BMC on completion of CPU power off sequence;
+ * @sys_off: power off prepare handler reporting CPU power off ready;
  */
 struct nvsw_core {
 	enum nvsw_core_hid_type hid;
@@ -320,6 +325,8 @@ struct nvsw_core {
 	void (*mux_exit)(struct nvsw_core *nvsw_core);
 	struct platform_device *mux[NVSW_MUX_MAX];
 	u32 mux_num;
+	bool cpu_pwr_off_notify;
+	struct sys_off_handler *sys_off;
 };
 
 /* Platform core init/exit functions. */
-- 
