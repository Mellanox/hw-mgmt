#
# Restarted by hw-management-bmc-events.sh on CPLD host power events. udev
# kills processes forked from a RUN handler once the event is handled, so the
# bind-retry loop runs here. Static unit, not enabled.
[Unit]
Description=Sync host-power-domain I2C devices with host power state
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/bin/hw-management-bmc-host-i2c-devices.sh sync
SyslogIdentifier=hw-management-bmc-host-i2c
