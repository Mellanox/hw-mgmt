[Unit]
Description=Setup BMC I2C Slave Device for Recovery Interface
After=multi-user.target
Before=hw-management-bmc-recovery-handler.service
ConditionPathExists=/etc/hw-management-bmc-recovery.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/hw-management-bmc-i2c-slave-setup.sh

[Install]
WantedBy=multi-user.target
